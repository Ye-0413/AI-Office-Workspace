{
  "description": "Schema-derived examples and upstream regression boundaries; no fixture in this file is a real captured user session.",
  "verifiedAt": "2026-10-15",
  "cases": [
    {
      "name": "codex direct test start",
      "provider": "codex",
      "provenance": "official-example",
      "sourceUrl": "https://learn.chatgpt.com/docs/hooks#pretooluse",
      "raw": {"session_id":"codex-a","cwd":"/example/mini-office","hook_event_name":"PreToolUse","turn_id":"turn-a","tool_name":"Bash","tool_use_id":"call-a","tool_input":{"command":"npm test"}},
      "expected": {"id":"codex:codex-a","event":"tool-start","activity":"testing","turnId":"turn-a","toolCallId":"call-a"}
    },
    {
      "name": "codex patch start",
      "provider": "codex",
      "provenance": "official-example",
      "sourceUrl": "https://learn.chatgpt.com/docs/hooks#tool-coverage",
      "raw": {"session_id":"codex-a","hook_event_name":"PreToolUse","turn_id":"turn-a","tool_name":"apply_patch","tool_use_id":"call-b","tool_input":{"command":"*** Begin Patch\n*** End Patch"}},
      "expected": {"event":"tool-start","activity":"coding"}
    },
    {
      "name": "codex result shape not fixed by hooks",
      "provider": "codex",
      "provenance": "official-example",
      "sourceUrl": "https://learn.chatgpt.com/docs/hooks#posttooluse",
      "raw": {"session_id":"codex-a","hook_event_name":"PostToolUse","turn_id":"turn-a","tool_name":"Bash","tool_use_id":"call-a","tool_input":{"command":"npm test"},"tool_response":"All tests passed"},
      "expected": {"event":"tool-end","activity":"testing","outcome":"unknown"}
    },
    {
      "name": "codex permission observation never approves",
      "provider": "codex",
      "provenance": "official-example",
      "sourceUrl": "https://learn.chatgpt.com/docs/hooks#permissionrequest",
      "raw": {"session_id":"codex-a","hook_event_name":"PermissionRequest","turn_id":"turn-a","tool_name":"Bash","tool_input":{"command":"npm ci"}},
      "expected": {"event":"waiting-user","activity":"waiting-user"}
    },
    {
      "name": "codex independently keyed child",
      "provider": "codex",
      "provenance": "official-example",
      "sourceUrl": "https://learn.chatgpt.com/docs/hooks#subagentstart",
      "raw": {"session_id":"codex-a","hook_event_name":"SubagentStart","turn_id":"turn-a","agent_id":"child-a","agent_type":"reviewer"},
      "expected": {"id":"codex:codex-a:child-a","parentId":"codex:codex-a","event":"subagent-start","activity":"waiting-tool"}
    },
    {
      "name": "codex stop remains open",
      "provider": "codex",
      "provenance": "official-example",
      "sourceUrl": "https://learn.chatgpt.com/docs/hooks#stop",
      "raw": {"session_id":"codex-a","hook_event_name":"Stop","turn_id":"turn-a","stop_hook_active":false,"last_assistant_message":"This text must never reach normalized storage."},
      "expected": {"event":"turn-end","activity":"idle"}
    },
    {
      "name": "codex interrupt distinct from failure",
      "provider": "codex",
      "provenance": "official-example",
      "sourceUrl": "https://learn.chatgpt.com/docs/hooks#interrupt",
      "raw": {"session_id":"codex-a","hook_event_name":"Interrupt","turn_id":"turn-a"},
      "expected": {"event":"interrupted","activity":"idle","outcome":"cancelled"}
    },
    {
      "name": "claude reading child tool preserves provenance",
      "provider": "claude-code",
