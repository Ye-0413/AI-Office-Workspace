{
  "name": "ai-mini-office",
  "version": "0.24.0",
  "description": "Observe your agent team collaboration in your spare display",
  "main": "main.cjs",
  "type": "commonjs",
  "author": "AI Work Space contributors",
  "license": "AGPL-3.0-only",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "test": "node --test test/*.test.cjs",
    "build": "electron-builder --mac dir --arm64 --publish never",
    "build:mac": "electron-builder --mac dmg zip --arm64 --publish never",
    "build:mac:x64": "electron-builder --mac dmg zip --x64 --publish never",
    "verify:bundle": "node scripts/verify-bundle.cjs",
    "verify:renderer": "electron test/renderer-smoke.cjs",
    "verify:packaged-hook": "node scripts/smoke-packaged-hook.cjs",
    "verify:packaged-flow": "node scripts/verify-packaged-flow.cjs",
    "verify:packaged-usage": "node scripts/verify-packaged-usage.cjs",
    "prebuild": "node scripts/sync-room-designs.cjs --check && node scripts/prepare-build.cjs",
    "prebuild:mac": "node scripts/sync-room-designs.cjs --check && node scripts/prepare-build.cjs",
    "prebuild:mac:x64": "node scripts/sync-room-designs.cjs --check && node scripts/prepare-build.cjs --arch x64",
    "pretest": "node scripts/sync-provider-catalog.cjs --check && node scripts/sync-room-designs.cjs --check",
    "sync:providers": "node scripts/sync-provider-catalog.cjs",
    "check:rooms": "node scripts/sync-room-designs.cjs --check",
    "sync:rooms": "node scripts/sync-room-designs.cjs",
    "verify:codex-restart": "electron scripts/verify-codex-restart.cjs"
  },
  "devDependencies": {
    "electron": "41.10.4",
    "electron-builder": "26.15.7"
  },
  "build": {
    "appId": "local.ai-mini-office",
    "productName": "AI Work Space",
    "copyright": "AI Work Space",
    "directories": {
      "output": "../dist-mini-office"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "lib/**/*",
      "src/claude-hook-operations.js",
      "hooks/**/*",
      "renderer/**/*",
      "assets/ORIGINAL-ARTWORK-LICENSE.txt",
